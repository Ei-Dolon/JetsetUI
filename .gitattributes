# 1. Enforce LF line endings for all text files
* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# 2. Blockchain smart contracts & configurations
*.sol text eol=lf
*.vy text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 3. JavaScript / TypeScript frontend & script files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.graphql text eol=lf

# 4. Shell scripts (will break in WSL if they use CRLF)
*.sh text eol=lf

# 5. Documentation & Environment files
*.md text eol=lf
.env* text eol=lf

# 6. Binary files (tell Git not to touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

