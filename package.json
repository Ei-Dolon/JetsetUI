		"prepare": "vp config"
	},
	"dependencies": {
		"@coinbase/wallet-sdk": "^4.3.7",
		"@fontsource-variable/inter": "^5.2.8",
		"@metamask/connect-evm": "^2.1.0",
		"@tanstack/react-query": "^5.101.0",
		"@walletconnect/ethereum-provider": "^2.23.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"viem": "~2.48.11",
		"wagmi": "~3.6.18"
	},
	"devDependencies": {
		"@types/node": "^25.9.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"globals": "^17.7.0",
		"typescript": "~6.0.3",
		"vite-plus": "^0.1.24"
	},
	"pnpm": {
		"peerDependencyRules": {
    		"ignoreMissing": [
    			"@solana/web3.js"
			],
